{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "A simple extensible skills frontend built with Vue 3, Pinia, and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.json\" \"*.md\""
  },
  "keywords": ["vue", "vite", "skills", "pinia", "typescript"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pinia": "^4.0.2",
    "primeicons": "~8.0.0",
    "primevue": "~4.1.0",
    "vue": "~3.5.0",
    "vue-router": "~5.2.0"
  },
  "devDependencies": {
    "@types/node": "~24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "~14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "~10.4.20",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "~9.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^30.0.1",
    "postcss": "~8.4.40",
    "prettier": "~3.0.0",
    "tailwindcss": "~3.4.4",
    "typescript": "~6.0.0",
    "vite": "~8.1.0",
    "vitest": "~1.5.0"
  }
}
